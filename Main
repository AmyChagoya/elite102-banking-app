import sqlite3

conn = sqlite3.connect("bank.db")
cursor = conn.cursor()

# creating the  table
cursor.execute("""
CREATE TABLE IF NOT EXISTS accounts (
    name TEXT PRIMARY KEY,
    balance REAL
)
""")
conn.commit()


class BankAccount:
    def __init__(self, name):
        self.name = name
        self.balance = self.load_account()

    def load_account(self):
        cursor.execute("SELECT balance FROM accounts WHERE name=?", (self.name,))
        result = cursor.fetchone()

        if result:
            return result[0]
        else:
            return None  # (for accounts that dont exists)

    def create_account(self, initial_deposit):
        if self.balance is not None:
            print("Account already exists.")
            return False

        cursor.execute(
            "INSERT INTO accounts (name, balance) VALUES (?, ?)",
            (self.name, initial_deposit)
        )
        conn.commit()
        self.balance = initial_deposit
        print("Account created!")
        return True

    def update_balance(self):
        cursor.execute(
            "UPDATE accounts SET balance=? WHERE name=?",
            (self.balance, self.name)
        )
        conn.commit()

    def deposit(self, amount):
        if amount > 0:
            self.balance += amount
            self.update_balance()
            print(f"Deposited ${amount}")
        else:
            print("Invalid amount")

    def withdraw(self, amount):
        if amount > self.balance:
            print("Not enough money")
        elif amount <= 0:
            print("Invalid amount")
        else:
            self.balance -= amount
            self.update_balance()
            print(f"Withdrew ${amount}")

    def check_balance(self):
        print(f"Current balance: ${self.balance}")


# list all accounts!!!
def list_accounts():
    cursor.execute("SELECT name, balance FROM accounts")
    accounts = cursor.fetchall()

    print("\nAccounts:")
    for acc in accounts:
        print(f"{acc[0]} - ${acc[1]}")


def main():
    print("Welcome to Bank App")

    while True:
        print("\n1. Create Account")
        print("2. Login")
        print("3. List Accounts")
        print("4. Exit")

        choice = input("Choose an option: ")

        if choice == "1":
            name = input("Enter name: ")
            try:
                deposit = float(input("Initial deposit: "))
            except:
                print("Invalid input")
                continue

            account = BankAccount(name)
            account.create_account(deposit)

        elif choice == "2":
            name = input("Enter name: ")
            account = BankAccount(name)

            if account.balance is None:
                print("Account not found")
                continue

            # account menu
            while True:
                print("\n1. Deposit")
                print("2. Withdraw")
                print("3. Check Balance")
                print("4. Back")

                sub_choice = input("Choose: ")

                if sub_choice == "1":
                    try:
                        amount = float(input("Amount: "))
                        account.deposit(amount)
                    except:
                        print("Invalid input")

                elif sub_choice == "2":
                    try:
                        amount = float(input("Amount: "))
                        account.withdraw(amount)
                    except:
                        print("Invalid input")

                elif sub_choice == "3":
                    account.check_balance()

                elif sub_choice == "4":
                    break

                else:
                    print("Invalid choice")

        elif choice == "3":
            list_accounts()

        elif choice == "4":
            print("Goodbye!")
            break

        else:
            print("Invalid choice")


if __name__ == "__main__":
    main()